        <mxCell id="c2" value="C. Sottosistema Concessionaria" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=140;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
