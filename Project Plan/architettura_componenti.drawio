  <diagram name="Back-Office" id="38587422650">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Back-Office" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1020" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="B. Sottosistema Back-Office" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=140;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="695" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Identity &amp; Access Management&lt;/b&gt;&lt;br&gt;Registrazione e verifica delle identita' degli attori business, emissione delle credenziali&lt;br&gt;di rete (MSP) e gestione dei permessi di accesso al canale permissioned." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="50" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;DMVP Registry&lt;/b&gt;&lt;br&gt;Creazione del passaporto digitale associato al numero di telaio e gestione della macchina&lt;br&gt;a stati del DMVP: Bozza, In Lavorazione, In Collaudo, Certificato e Conforme, Trasferito." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="155" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Off-Chain Store Manager&lt;/b&gt;&lt;br&gt;Persistenza dei dati descrittivi, delle schede tecniche e dei documenti; calcolo dell'hash&lt;br&gt;crittografico da ancorare sulla blockchain e verifica di integrita' in lettura." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="260" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Blockchain Gateway&lt;/b&gt;&lt;br&gt;Unico punto di accesso alla rete Hyperledger Fabric: sottomissione delle transazioni,&lt;br&gt;invocazione del chaincode, gestione degli eventi di commit e delle policy di endorsement." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="365" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Notifiche ed Eventi&lt;/b&gt;&lt;br&gt;Orchestrazione del workflow tra gli attori: notifica di presa in carico all'Azienda di Tuning,&lt;br&gt;di fine lavorazioni al Centro di Certificazione e di esito collaudo alla Concessionaria." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="470" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Ricerca, Verifica e Audit&lt;/b&gt;&lt;br&gt;Consultazione dello storico immutabile, verifica di autenticita' tramite QR code&lt;br&gt;e tracciatura delle operazioni per finalita' di audit." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="575" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Il Back-Office e' condiviso da tutti gli attori ed e' l'unico livello autorizzato a scrivere sulla blockchain.&lt;br&gt;I dati descrittivi risiedono off-chain: sulla catena viene ancorato soltanto l'hash crittografico, garantendo immutabilita' e contenimento dei costi di transazione." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="785" width="1020" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
