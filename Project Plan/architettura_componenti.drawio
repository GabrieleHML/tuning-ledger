        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Gestione Dati Veicolo Base&lt;/b&gt;&lt;br&gt;Acquisizione dei dati identificativi del veicolo originale (telaio, allestimento, omologazione)&lt;br&gt;forniti dalla Casa Automobilistica e loro validazione." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="50" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Inizializzazione DMVP e Richiesta di Tuning&lt;/b&gt;&lt;br&gt;Creazione dell'istanza di DMVP in stato Bozza, registrazione delle modifiche commissionate&lt;br&gt;dal Cliente Privato e inoltro della richiesta all'Azienda di Tuning." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="155" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Gestione Consegna e Trasferimento DMVP&lt;/b&gt;&lt;br&gt;Avvio della procedura di consegna del veicolo omologato e richiesta di trasferimento&lt;br&gt;della proprieta' del passaporto digitale all'account del Cliente Privato." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="260" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Copre gli use case UC1 (Registrazione del veicolo base e della richiesta di tuning) e UC4 (Consegna del veicolo e trasferimento del DMVP)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1020" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Azienda di Tuning" id="88948381068">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Azienda di Tuning" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1020" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="D. Sottosistema Azienda di Tuning" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=140;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Gestione Commessa di Tuning&lt;/b&gt;&lt;br&gt;Presa in carico della richiesta, pianificazione delle lavorazioni e aggiornamento&lt;br&gt;dello stato di avanzamento della commessa." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="50" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Registrazione Modifiche e Seriali Componenti&lt;/b&gt;&lt;br&gt;Inserimento delle specifiche tecniche degli interventi e dei codici seriali dei componenti&lt;br&gt;installati, con verifica della provenienza certificata presso i Fornitori." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="155" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Acquisizione Prove Multimediali e Documentazione Tecnica&lt;/b&gt;&lt;br&gt;Caricamento di fotografie, video e schede tecniche a corredo delle modifiche eseguite,&lt;br&gt;con marcatura temporale e ancoraggio dell'hash sulla blockchain." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="260" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Copre lo use case UC2 (Esecuzione del tuning e registrazione delle modifiche): e' il cuore operativo della piattaforma, in cui il DMVP viene arricchito in modo immutabile." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1020" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Centro di Certificazione" id="460316801357">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Centro di Certificazione" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1020" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="E. Sottosistema Centro di Certificazione" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=140;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Gestione Ispezione e Collaudo&lt;/b&gt;&lt;br&gt;Consultazione dello storico immutabile del DMVP, esecuzione della checklist normativa&lt;br&gt;e registrazione degli esiti delle verifiche tecniche." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="50" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Emissione e Registrazione Certificato di Conformita'&lt;/b&gt;&lt;br&gt;Generazione del certificato digitale firmato, archiviazione off-chain del documento&lt;br&gt;e ancoraggio del relativo hash sulla blockchain, con aggiornamento dello stato del DMVP." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="155" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Segnalazione Non Conformita'&lt;/b&gt;&lt;br&gt;Produzione del report di anomalia in caso di esito negativo del collaudo&lt;br&gt;e reindirizzamento della pratica all'Azienda di Tuning per le correzioni." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="260" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Copre lo use case UC3 (Ispezione, collaudo e rilascio della certificazione). Il modulo si interfaccia con la Motorizzazione Civile per la pratica di omologazione delle modifiche." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1020" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Front-End Unificato" id="692001506665">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Front-End Unificato" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1020" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="F. Sottosistema Front-End Unificato" style="shape=folder;fontStyle=1;spacingTop=12;tabWidth=140;tabHeight=22;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1020" height="485" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Portale Web B2B&lt;/b&gt;&lt;br&gt;Interfaccia unica per Concessionaria, Azienda di Tuning e Centro di Certificazione,&lt;br&gt;con viste e permessi differenziati in base al ruolo dell'utente autenticato." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="50" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;App Mobile B2C Cliente Privato&lt;/b&gt;&lt;br&gt;Consultazione dello storico immutabile del veicolo, scansione del QR code applicato&lt;br&gt;al mezzo, accettazione della consegna e notifiche a ogni aggiornamento del DMVP." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="155" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Console di Governance Intermediario&lt;/b&gt;&lt;br&gt;Amministrazione della rete permissioned, gestione dei nodi e delle policy, onboarding&lt;br&gt;degli attori business e cruscotto di analisi dei dati di esercizio." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="260" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;Punto di ingresso unico ai micro-servizi: autenticazione, autorizzazione, rate limiting&lt;br&gt;e integrazione con i sistemi gestionali dei partner." style="html=1;dropTarget=0;whiteSpace=wrap;shape=module;align=left;spacingLeft=22;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="40" y="365" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Il front-end e' realizzato come applicazione unica multi-ruolo: la separazione tra utenti B2B e B2C avviene a livello di autenticazione e di profilo autorizzativo." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="1020" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
