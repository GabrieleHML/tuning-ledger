        <mxCell id="c19" value="&lt;b&gt;SA - Software Architect&lt;/b&gt;&lt;br&gt;Progettazione dell'architettura a micro-servizi e delle scelte tecnologiche; presidio della qualita' del codice." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="583" width="1410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;FSD - Full Stack Developer&lt;/b&gt;&lt;br&gt;Sviluppo di front-end, back-end e chaincode; guida tecnica dei gruppi di lavoro." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
