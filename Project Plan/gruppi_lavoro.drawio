  <diagram name="Gruppi di Lavoro - Fase 2" id="613373235222">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="660" math="0" shadow="0">
