        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Fase 2 - Esercizio della Piattaforma: Gruppo di Lavoro (Anni 1-5)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="15" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="8 persone complessive - 12.264 O/P per anno - 7,00 A/P per anno" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="1400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;GRUPPO 4&lt;/b&gt;&lt;hr size=&quot;1&quot; style=&quot;border-color:#999999;&quot;&gt;0,50 PM&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;0,50 SA&lt;br&gt;2 FSD&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;4 FSDJ&lt;hr size=&quot;1&quot; style=&quot;border-color:#999999;&quot;&gt;&lt;b&gt;8 persone&lt;/b&gt;&lt;br&gt;61.320 O/P&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;35,00 A/P&lt;hr size=&quot;1&quot; style=&quot;border-color:#999999;&quot;&gt;&lt;i&gt;A. Promozione e Assistenza Commerciale&lt;br&gt;B. Manutenzione Ordinaria&lt;br&gt;C. Manutenzione Evolutiva&lt;br&gt;D. Assistenza e Onboarding degli Attori&lt;br&gt;E. Analisi dei Dati di Esercizio&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#B1DDF0;strokeColor=#10739E;fontSize=12;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="420" height="245" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;A. Promozione della Piattaforma e Assistenza Commerciale&lt;/b&gt;&lt;br&gt;Campagne di marketing, presentazioni commerciali a concessionarie e reti di tuning, gestione delle trattative e personalizzazione dell'offerta." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;B. Manutenzione Ordinaria&lt;/b&gt;&lt;br&gt;Aggiornamenti di sicurezza, correzione dei difetti, monitoraggio delle prestazioni e gestione dei nodi della rete permissioned." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="178" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;C. Manutenzione Evolutiva&lt;/b&gt;&lt;br&gt;Nuove funzionalita' in risposta alle esigenze degli utenti e alle evoluzioni normative; integrazione con nuovi sistemi esterni." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="246" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;D. Assistenza e Onboarding degli Attori&lt;/b&gt;&lt;br&gt;Supporto tecnico e formazione di concessionarie, aziende di tuning e centri di certificazione; gestione delle identita' di rete." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="314" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;E. Analisi dei Dati di Esercizio della Piattaforma&lt;/b&gt;&lt;br&gt;Raccolta e analisi dei dati d'uso, reportistica per gli attori business e supporto alle decisioni strategiche." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="382" width="950" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Nella fase di esercizio l'organico si riduce da 12 a 8 persone: Project Manager e Software Architect sono impegnati al 50%, mentre il nucleo di sviluppo scende a 2 Full Stack Developer e 4 Junior. La Manutenzione Evolutiva entra a regime a partire dall'Anno 3, quando la piattaforma ha raggiunto una base di utenti sufficiente a orientarne l'evoluzione." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=16;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="1410" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
