        <mxCell id="c18" value="&lt;b&gt;PM - Project Manager&lt;/b&gt;&lt;br&gt;Pianificazione, gestione e coordinamento dell'intero progetto; interfaccia verso gli stakeholder." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="525" width="1410" height="50" as="geometry" />
